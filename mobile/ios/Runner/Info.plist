<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>id</string>
	<key>CFBundleDisplayName</key>
	<string>Klubby</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>klubby</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>id.klubby.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>klubby</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>strava</string>
		<string>https</string>
		<string>instagram-stories</string>
	</array>

	<!-- Sensor & data usage strings (Bahasa Indonesia, shown in the system prompts) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Klubby memakai lokasimu untuk merekam rute lari/sepeda, memverifikasi check-in di venue, dan mencari mabar terdekat.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Agar rekaman GPS tetap jalan saat layar mati dan Beacon keselamatan bisa membagikan lokasi live ke kontak daruratmu.</string>
	<key>NSCameraUsageDescription</key>
	<string>Kamera dipakai untuk scan QR check-in di venue dan mengambil foto profil.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pilih foto dari galeri untuk foto profil atau postingan aktivitas.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Simpan kode QR pembayaran dan kartu story aktivitasmu ke galeri.</string>
	<key>NSMotionUsageDescription</key>
	<string>Sensor gerak dipakai untuk fitur Goyang Ajak Main dan menghitung langkah/kadens saat merekam.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Klubby membaca latihan, detak jantung, dan jarak dari Apple Health/Apple Watch untuk menghitung streak dan XP terverifikasi.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Klubby menyimpan aktivitas yang kamu rekam ke Apple Health.</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
