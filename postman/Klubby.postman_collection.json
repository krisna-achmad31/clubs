{
 "info": {
  "name": "Klubby API",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Pilih environment Klubby Dev atau Klubby Live. Auth dipakai bersama. Request mutasi mengubah data pada schema aktif. Endpoint lanjutan bergantung pada migrasi yang terpasang. Lihat postman/README.md."
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{access_token}}",
    "type": "string"
   }
  ]
 },
 "item": [
  {
   "name": "Auth",
   "item": [
    {
     "name": "Login email",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "apikey",
        "value": "{{publishable_key}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{base_url}}/auth/v1/token?grant_type=password",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "auth": {
       "type": "noauth"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "if (pm.response.code >= 200 && pm.response.code < 300) {",
         "  const data = pm.response.json();",
         "  if (data.access_token && data.refresh_token && data.user?.id) {",
         "    pm.environment.set(\"access_token\", data.access_token);",
         "    pm.environment.set(\"refresh_token\", data.refresh_token);",
         "    pm.environment.set(\"user_id\", data.user.id);",
         "  }",
         "}"
        ]
       }
      }
     ]
    },
    {
     "name": "Daftar akun",
     "request": {
      "method": "POST",
